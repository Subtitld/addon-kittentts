{
  "manifest_version": 1,
  "id": "kittentts",
  "version": "26.10.1",
  "display_name": "KittenTTS 2 (offline, voice clone, 16 languages)",
  "summary": "KittenML's KittenTTS 2: speaks 16 languages at 24 kHz in the speaker's own voice, cloned from the video, or in 115 built-in voices, on the CPU at about real time. The model, about 1.6 GB, downloads on first use; cloning adds 540 MB. The weights are under the Stellon Labs Community License: commercial use is free only below US$1M a year in revenue or funding, and needs registering with Stellon Labs.",
  "author": "Subtitld",
  "homepage": "https://github.com/Subtitld/addon-kittentts",
  "license": "Apache-2.0 (add-on); MIT and Apache-2.0 (runtime, reference encoder); Stellon Labs Community License (KittenTTS 2 weights, downloaded on first use)",
  "executable": "bin/kittentts-addon",
  "protocol": 1,
  "startup_timeout_sec": 30,
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "tasks": [
    "tts.synthesize"
  ],
  "compute": "cpu",
  "voice_clone": true,
