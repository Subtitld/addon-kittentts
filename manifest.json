  "models": [
    {
      "id": "kitten-tts-2",
      "display_name": "KittenTTS 2 (1.7B, ternary)",
      "repo": "KittenML/kitten-tts-2",
      "revision": "c93cb7c271baa51d9ae8204d5277988906f235a2",
      "size_mb": 1588,
      "license": "Stellon Labs Community License",
      "bundled": false,
      "default": true
    },
    {
      "id": "ref-encoder",
      "display_name": "Reference encoder, for cloning",
      "repo": "Subtitld/addon-kittentts",
      "size_mb": 517,
      "license": "MIT",
      "bundled": false,
      "default": false
    }
  ],
  "disk_required_mb": 2900,
  "ram_required_mb": 3072,
  "config_schema": {
    "fields": [
      {
        "key": "preset",
        "type": "select",
        "label": "Delivery",
        "default": "stable",
        "options": [
          {
            "value": "stable",
            "label": "Stable: KittenTTS's default"
          },
          {
            "value": "expressive",
            "label": "Expressive: livelier, less predictable"
          }
        ],
        "help": "How freely the model samples its speech. Expressive suits drama, but a line may come out odd more often; listen before dubbing a whole film with it."
      },
      {
        "key": "threads",
        "type": "int",
        "label": "CPU threads",
        "default": 0,
        "min": 0,
        "max": 256,
        "step": 1,
        "help": "0 picks the performance cores on a CPU that also has efficiency cores, else one thread per core, at most 8. Fewer leaves the computer more responsive while dubbing."
      },
      {
        "key": "voice_ref_audio",
        "type": "file",
        "label": "Fallback reference clip",
        "help": "Used by the speaker's own voice when Subtitld has no clip of the speaker to send: 3 to 30 seconds of one person speaking, WAV preferred."
      },
      {
        "key": "voice_ref_text",
        "type": "string",
        "label": "Fallback reference transcript",
        "help": "The exact words spoken in the fallback clip. With them the clone is closer to the speaker and makes fewer mistakes."
      },
      {
        "key": "skip_ref_text",
        "type": "bool",
        "default": false,
        "label": "Clone the timbre only",
        "help": "Subtitld normally sends, with the speaker's clip, the subtitle text spoken in it, and KittenTTS then continues from the clip, which is closer to the speaker and steadier. With this on, only the timbre is cloned. Try it if a dub into another language keeps the speaker's accent, or when the subtitles paraphrase the speech."
      }
    ]
  }
}
